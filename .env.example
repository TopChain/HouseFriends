EXPO_PUBLIC_APP_MODE=demo
EXPO_PUBLIC_ENABLE_DEMO_MODE=true
EXPO_PUBLIC_NEON_AUTH_URL=https://ep-winter-fire-aydrugpk.neonauth.c-5.us-east-2.aws.neon.tech/neondb/auth
