{
  "name": "housefriends",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.9",
    "@maplibre/maplibre-react-native": "11.3.6",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@supabase/supabase-js": "2.112.3",
    "expo": "~57.0.12",
    "expo-apple-authentication": "~57.0.1",
    "expo-auth-session": "~57.0.6",
    "expo-constants": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-dev-client": "~57.0.11",
    "expo-image": "~57.0.2",
    "expo-image-manipulator": "~57.0.9",
    "expo-image-picker": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.27.0",
    "react-native-web": "~0.21.2",
    "react-native-url-polyfill": "4.0.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/react": "~19.2.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.1",
    "eslint-import-resolver-typescript": "3.10.1",
    "jest-expo": "57.0.4",
    "prettier": "3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "jest --runInBand",
    "test:roles": "node --test tests/role-flows.test.mjs",
    "verify": "npm run test && npm run test:ui && npm run typecheck && npm run lint && npx expo-doctor",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "build:preview:android": "eas build --platform android --profile preview",
    "build:production": "eas build --platform all --profile production",
    "submit:production": "eas submit --platform all --profile production",
    "eas-build-pre-install": "node scripts/validate-production-env.mjs"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "private": true
}
